# Copy to .env.local for local testing. On Vercel: Settings -> Environment Variables.
# Email for the quotation form (app/api/quote/route.js). Use EITHER SMTP OR Resend.

# SMTP: the login of the info@zerosoft26.com mailbox at your email provider
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@zerosoft26.com
SMTP_PASS=

# Or Resend (https://resend.com), after verifying zerosoft26.com there
RESEND_API_KEY=

# Optional
MAIL_FROM="zerosoft <info@zerosoft26.com>"
MAIL_TO=info@zerosoft26.com
